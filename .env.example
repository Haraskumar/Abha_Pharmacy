# =============================================================================
# Abha Pharmacy - Production Environment Configuration Template
# Copy this file to .env for local Docker/Cloud execution.
# NEVER commit real passwords or private keys to version control.
# =============================================================================

# Cloud Database Configuration (e.g. Aiven, Railway, Supabase)
SPRING_DATASOURCE_URL=jdbc:mysql://<cloud-db-host>:3306/abha_pharmacy?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_secure_cloud_db_password

# Port binding (Automatically managed by Render / Railway)
PORT=8081

# Google Gemini Clinical AI Copilot (Optional)
GEMINI_API_KEY=AIzaSy...

# Razorpay / Payment Gateway Sandbox (Optional)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
